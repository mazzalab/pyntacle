#!/bin/bash
# One benchmark shard. Submit with benchmarks/pbs/submit.sh, which sets
# SHARD (e.g. 2/4), PROFILE, the host and the resources from the config's
# "pbs" block; do not qsub this directly.
#PBS -j oe
#PBS -M manuel.mangoni@guest.policlinicogemelli.it
#PBS -m abe

set -euo pipefail
REPO=/data/data_storage/research/Mangoni_Manuel/pyntacle_final
OUT=$REPO/benchmarks/results/$PROFILE

# the setup builds the extensions and the graph corpus; without it the shard
# would time stale code or race on missing graphs
if [ ! -f "$REPO/benchmarks/results/.setup_ok" ]; then
    echo "setup not done (benchmarks/results/.setup_ok missing): exiting"; exit 1
fi

source /home/04203147/miniconda3/etc/profile.d/conda.sh
conda activate graphtacle_debug
mkdir -p "$OUT"
cd "$REPO/benchmarks"

echo "host=$(hostname) shard=$SHARD profile=$PROFILE ncpus=${NCPUS:-?} start=$(date -Is)"
# resumable: rows already in runs_raw_<shard>.tsv are skipped, so resubmitting
# the same shard after a kill or walltime just continues
python bench.py run "configs/$PROFILE.json" --shard "$SHARD" --out "$OUT"
echo "end=$(date -Is)"
